SUMMARIZECOLUMNS(
    'Assets'[AssetID],
    'Assets'[AssetName],
    'Assets'[Site],
    'Assets'[EquipmentType],
    'Usage'[ReportDate],
    "OperatingHours", SUM('Usage'[OperatingHours]),
    "IdleHours", SUM('Usage'[IdleHours]),
    "FuelLitres", SUM('Usage'[FuelLitres]),
    "Utilization", DIVIDE(SUM('Usage'[OperatingHours]), SUM('Usage'[ScheduledHours]))
)</CommandText><QueryParameters><QueryParameter Name="Site"><Value>=Parameters!Site.Value</Value></QueryParameter></QueryParameters></Query><Fields><Field Name="AssetID"><DataField>Assets[AssetID]</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AssetName"><DataField>Assets[AssetName]</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Site"><DataField>Assets[Site]</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="EquipmentType"><DataField>Assets[EquipmentType]</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ReportDate"><DataField>Usage[ReportDate]</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="OperatingHours"><DataField>[OperatingHours]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="IdleHours"><DataField>[IdleHours]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="FuelLitres"><DataField>[FuelLitres]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="Utilization"><DataField>[Utilization]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields></DataSet></DataSets><ReportParameters><ReportParameter Name="DateFrom"><DataType>String</DataType><Prompt>Date From</Prompt></ReportParameter><ReportParameter Name="DateTo"><DataType>String</DataType><Prompt>Date To</Prompt></ReportParameter><ReportParameter Name="Site"><DataType>String</DataType><Prompt>Site</Prompt></ReportParameter></ReportParameters><ReportParametersLayout><GridLayoutDefinition><NumberOfColumns>3</NumberOfColumns><NumberOfRows>1</NumberOfRows><CellDefinitions><CellDefinition><ColumnIndex>0</ColumnIndex><RowIndex>0</RowIndex><ParameterName>DateFrom</ParameterName></CellDefinition><CellDefinition><ColumnIndex>1</ColumnIndex><RowIndex>0</RowIndex><ParameterName>DateTo</ParameterName></CellDefinition><CellDefinition><ColumnIndex>2</ColumnIndex><RowIndex>0</RowIndex><ParameterName>Site</ParameterName></CellDefinit